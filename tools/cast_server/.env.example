# 程序说明：Waveshare ESP32-S3-RLCD-4.2 无线投屏后台与网页端控台配置模板
# 请复制为 .env 后按实际网络环境修改（.env 已被 .gitignore 忽略）

# 设备连接配置
DEVICE_IP=192.168.1.100
DEVICE_PORT=8080
CAST_TOKEN=
HTTP_TIMEOUT_SEC=3.0

# 后台与网页控台监听配置
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8787

# 推送调度策略
PUSH_INTERVAL_MS=1000
SKIP_UNCHANGED=true
HEARTBEAT_INTERVAL_SEC=10
CAST_TIMEOUT_SEC=30
AUTO_SWITCH=false

# 屏幕与灰度转换配置
SCREEN_WIDTH=400
SCREEN_HEIGHT=300
DITHER_MODE=floyd
THRESHOLD=128
FIT_MODE=contain
ROTATE=0
INVERT=false
