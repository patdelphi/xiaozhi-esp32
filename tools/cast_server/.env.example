# 程序说明：Waveshare ESP32-S3-RLCD-4.2 无线投屏后台与网页端控台配置模板
# 请复制为 .env 后按实际网络环境修改（.env 已被 .gitignore 忽略）；行尾 # 后内容为参数备注

# 设备连接配置
DEVICE_IP=192.168.1.100     # 设备端（ESP32-S3-RLCD-4.2 第四屏）显示的 IPv4 地址
DEVICE_PORT=8080            # 设备端内置投屏接收服务 HTTP 端口（固定 8080）
CAST_TOKEN=                 # 可选鉴权令牌（需与固件 secret_config.h 中一致，留空表示不启用）
HTTP_TIMEOUT_SEC=3.0        # 向设备推送单帧或查询状态的 HTTP 超时时间（秒）

# 后台与网页控台监听配置
LISTEN_HOST=0.0.0.0         # 本控台服务绑定地址（0.0.0.0 允许局域网访问 / 127.0.0.1 仅本机）
LISTEN_PORT=8787            # 后台收图与网页端控台访问端口（默认 8787）

# 推送调度策略
PUSH_INTERVAL_MS=1000       # 定时向设备推帧的最小间隔（毫秒，建议 200-2000）
SKIP_UNCHANGED=true         # 相同帧哈希去重跳过：true 省流防闪烁 / false 每次强制重刷
HEARTBEAT_INTERVAL_SEC=10   # 空闲无新帧时发送保活心跳的间隔（秒，0 表示关闭）
CAST_TIMEOUT_SEC=30         # 通知设备端投屏超时自动退回等待页的时长（秒，0 表示不超时）
AUTO_SWITCH=false           # 收到画面时是否请求设备自动切至第 4 屏（true/false）

# 屏幕与灰度转换配置
SCREEN_WIDTH=400            # 目标设备屏幕宽度像素（必须为 8 的倍数，本板默认 400）
SCREEN_HEIGHT=300           # 目标设备屏幕高度像素（本板默认 300）
DITHER_MODE=floyd           # 1-bit 黑白转换算法：floyd / atkinson / bayer / threshold
THRESHOLD=128               # 二值化灰度阈值（0-255，默认 128）
FIT_MODE=contain            # 画面缩放裁剪模式：contain 等比留白 / cover 等比裁切 / stretch 拉伸
ROTATE=0                    # 画面顺时针旋转角度：0 / 90 / 180 / 270
INVERT=false                # 黑白反相显示：false 白底黑字 / true 黑底白字
